  whyCard2Text            String   @default("Choose your wash package, select your slot, and track everything live.")
  whyCard3Title           String   @default("Trained Specialists")
  whyCard3Text            String   @default("Background-verified, trained vehicle care professionals using pH-neutral premium shampoos.")
  whyCard4Title           String   @default("Water-Efficient Care")
  whyCard4Text            String   @default("Eco-conscious steam & pressure washing saves up to 80% water compared to traditional washing.")

  // Metrics / Stats
  statCustomers           String   @default("10K+")
  statCustomersLabel      String   @default("Happy Vehicle Owners")
  statCities              String   @default("2+")
  statCitiesLabel         String   @default("Service Hubs Live")
  statDuration            String   @default("30–90")
  statDurationLabel       String   @default("Minutes Service Time")
  statPrice               String   @default("₹299+")
  statPriceLabel          String   @default("Starting Wash Price")

  // Partner / Franchise
  partnerTitle            String   @default("BUILD THE NEXT CAR CARE BUSINESS")
  partnerSubtitle         String   @default("Choose the operating model that fits your city — doorstep franchise partner or fixed branded outlet.")
