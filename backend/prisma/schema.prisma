  quickBarSubtitle        String   @default("Book doorstep vehicle detailing in seconds.")

  // Services / Detailing info
  aboutTitle              String   @default("Serving Visakhapatnam & Surrounds")
  aboutText               String   @default("We proudly serve all Visakhapatnam neighborhoods with professional care and premium equipment!")
  servicesTitle           String   @default("EVERYDAY CARE. PREMIUM SHINE.")
  servicesSubtitle        String   @default("One destination for your vehicle's everyday wash, interior deep steam, and premium shine.")
  
  // Why Choose Us / The Difference
  whyTitle                String   @default("SMARTER CAR CARE. BUILT AROUND YOU.")
  whySubtitle             String   @default("Convenience-first automotive detailing with professional equipment and RO water efficiency.")
  whyCard1Title           String   @default("YOUR CAR STAYS. WE COME TO YOU.")
  whyCard1Text            String   @default("No queues. No driving to wash centres. Our technicians arrive at your home or office with high-pressure machines and RO water.")
