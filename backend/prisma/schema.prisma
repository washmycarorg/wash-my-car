generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  phone          String          @unique
  name           String?
  email          String?
  points         Int             @default(0)
  cars           Car[]
  bookings       Booking[]
  savedAddresses SavedAddress[]
  offers         Offer[]         @relation("UserEligibleOffers")
  createdAt      DateTime        @default(now())
}

model Employee {
  id            Int           @id @default(autoincrement())
  phone         String        @unique
  email         String        @unique
  name          String
  status        String        @default("PENDING") // PENDING, ACTIVE, SUSPENDED
  onDuty        Boolean       @default(false)
  salary        Float         @default(0) // Monthly salary or hourly wage
  photo         String?       // Base64 profile/verification photo
  aadhaarNumber String?
  address       String?
  idProofFile   String?       // Base64 ID proof (pdf or image)
  bookings      Booking[]
  leaves        Leave[]
  serviceAreas  ServiceArea[] @relation("EmployeeAreas")
  inventoryAllocations InventoryAllocation[]
  allowProfileUpdate   Boolean       @default(false)
  createdAt            DateTime      @default(now())
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Hashed
  createdAt DateTime @default(now())
}

model CarType {
  id        Int         @id @default(autoincrement())
  name      String      @unique // e.g. Sedan, SUV, Hatchback, etc.
  cars      Car[]
  bookings  Booking[]
  prices    WashPrice[]
  createdAt DateTime    @default(now())
}

model WashType {
  id          Int         @id @default(autoincrement())
  name        String      @unique // e.g. Basic, Premium, Full
  description String?
  bookings    Booking[]
  prices      WashPrice[]
  createdAt   DateTime    @default(now())
}

model WashPrice {
  id          Int      @id @default(autoincrement())
  carTypeId   Int
  carType     CarType  @relation(fields: [carTypeId], references: [id], onDelete: Cascade)
  washTypeId  Int
  washType    WashType @relation(fields: [washTypeId], references: [id], onDelete: Cascade)
  price       Float
  payoutType  String   @default("PERCENTAGE") // PERCENTAGE or AMOUNT
  payoutValue Float   @default(50.0)         // 50% or flat price
  companyCost Float    @default(0.0)
  createdAt   DateTime @default(now())

  @@unique([carTypeId, washTypeId])
}

model Car {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  make      String
  model     String
  carTypeId Int
  carType   CarType   @relation(fields: [carTypeId], references: [id])
  bookings  Booking[]
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  price       Float
  type        String    // Basic, Premium, Full
  bookings    Booking[]
}

model ServiceArea {
  id             Int            @id @default(autoincrement())
  name           String         @unique // e.g. Bandra, Hitech City
  employees      Employee[]     @relation("EmployeeAreas")
  bookings       Booking[]
  savedAddresses SavedAddress[]
  createdAt      DateTime       @default(now())
}

model SavedAddress {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String       // e.g. Home, Work
  address       String
  latitude      Float
  longitude     Float
  serviceAreaId Int
  serviceArea   ServiceArea  @relation(fields: [serviceAreaId], references: [id])
  createdAt     DateTime     @default(now())
}

model Booking {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  employeeId    Int?
  employee      Employee?    @relation(fields: [employeeId], references: [id])
  carId         Int?
  car           Car?         @relation(fields: [carId], references: [id])
  carTypeId     Int
  carType       CarType      @relation(fields: [carTypeId], references: [id])
  washTypeId    Int
  washType      WashType     @relation(fields: [washTypeId], references: [id])
  serviceId     Int?         // Optional for fallback/compatibility
  service       Service?     @relation(fields: [serviceId], references: [id])
  date          DateTime
  timeSlot      String
  status        String       @default("PENDING") // PENDING, ASSIGNED, STARTED, COMPLETED, CANCELLED
  latitude      Float
  longitude     Float
  address       String
  serviceAreaId Int
  serviceArea   ServiceArea  @relation(fields: [serviceAreaId], references: [id])
  price         Float
  employeePayout Float       @default(0.0)
  companyCost   Float       @default(0.0)
  appliedOfferCode String?
  pointsRedeemed Int       @default(0)
  pointsEarned   Int       @default(0)
  paymentStatus String       @default("PENDING")
  paymentMethod String       @default("ONLINE")
  
  // Service pictures and locations
  startImage     String?
  startLatitude  Float?
  startLongitude Float?
  startAt        DateTime?
  
  endImage       String?
  endLatitude    Float?
  endLongitude   Float?
  endAt          DateTime?

  createdAt   DateTime  @default(now())
}

model Leave {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
}

model Offer {
  id                   Int             @id @default(autoincrement())
  code                 String          @unique
  title                String
  description          String
  discountType         String          @default("PERCENTAGE") // PERCENTAGE, FLAT
  discountPct          Float           @default(0.0)          // used if PERCENTAGE
  discountAmount       Float           @default(0.0)          // used if FLAT
  limitOption          String          @default("UNLIMITED")  // UNLIMITED, UP_TO
  maxDiscountAmount    Float?                                 // used if UP_TO
  applicableCarTypeIds String          @default("")           // comma-separated ids, empty = ALL
  applicableWashTypeIds String         @default("")           // comma-separated ids, empty = ALL
  userType             String          @default("ALL")        // ALL, NEW, SELECTED
  usageLimit           Int             @default(0)            // count limit (0 = unlimited)
  rotation             String          @default("UNLIMITED")  // UNLIMITED, OVERALL, MONTHLY, YEARLY
  eligibleUsers        User[]          @relation("UserEligibleOffers")
  validUntil           DateTime
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())
}

model InventoryItem {
  id             Int                   @id @default(autoincrement())
  name           String
  type           String                // EQUIPMENT, CHEMICAL, OTHER
  totalQuantity  Float                 @default(0.0)
  washesPerUnit  Float                 @default(1.0) // config for washes per unit
  allocations    InventoryAllocation[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model InventoryAllocation {
  id              Int           @id @default(autoincrement())
  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  employeeId      Int
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  quantity        Float         // allocated stock units
  washesUsed      Int           @default(0) // incremented when employee completes a booking
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SystemSettings {
  id                  Int     @id @default(1)
  autoAssignment      Boolean @default(true)   // Auto assignment mode ON/OFF
  pointsRedemption    Boolean @default(true)   // Royalty redemption mode ON/OFF
  pointsReward        Boolean @default(true)   // Earning points reward mode ON/OFF
  pointsToCashRatio   Float   @default(4.0)   // 4 points = 1 Rs
  rewardPointsRatio   Float   @default(0.1)   // 10% points reward
}

model CmsContent {
  id             Int      @id @default(1)
  heroTitle      String   @default("Professional Car Wash at Your Doorstep")
  heroSubtitle   String   @default("Fast, affordable, and eco-friendly car cleaning in Visakhapatnam.")
  heroImage      String   @default("/images/hero_wash.png")
  aboutTitle     String   @default("Serving Visakhapatnam & Surrounds")
  aboutText      String   @default("We proudly serve all Visakhapatnam neighborhoods with professional care and premium equipment!")
  contactPhone   String   @default("+91 98765 43210")
  contactEmail   String   @default("washmycarorg@gmail.com")
  contactAddress String   @default("Sujatha Nagar, Vizag")
  promoTitle     String   @default("Get 20% OFF Your First Wash!")
  promoText      String   @default("Claim Offer")
}
