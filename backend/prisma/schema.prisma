  outletPlanPrice         String   @default("₹3.5 LAKH")
  outletPlanPerks         String   @default("Storefront branding,Interior setup,High-end pressure equipment,Technology & SOPs")

  // Contact details
  contactPhone            String   @default("+91 98765 43210")
  contactEmail            String   @default("washmycarorg@gmail.com")
  contactAddress          String   @default("Sujatha Nagar, Visakhapatnam, Andhra Pradesh")
